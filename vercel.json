{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/lusion.co/index.html" },
    { "source": "/about", "destination": "/lusion.co/about.html" },
    { "source": "/projects", "destination": "/lusion.co/projects.html" },
    { "source": "/projects/:slug", "destination": "/lusion.co/projects/:slug" },
    { "source": "/((?!lusion.co/).*)", "destination": "/lusion.co/$1" }
  ]
}
